#!/bin/sh
# DS-212j: ask ds212j-boardd to re-evaluate the disk-health LEDs now (amber HDD LEDs,
# STATUS LED). Called by mdadm --monitor (PROGRAM in mdadm.conf) on every RAID event.
# The LEDs themselves are driven by the resident ds212j-boardd daemon.
exec /usr/bin/systemctl kill --signal=USR1 --kill-whom=main ds212j-boardd.service 2>/dev/null
