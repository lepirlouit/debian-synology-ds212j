#!/bin/sh
# Synology DS-212j disk-health LEDs, like DSM (Synology DS212j hardware guide):
#   HDD amber  on            = the disk in that bay is faulty in an md array,
#                              or SMART says it is failing
#   STATUS     green         = all volumes (md arrays) normal
#   STATUS     orange blink  = a volume is degraded/crashed, or no volume exists
#   Hibernation (all internal disks in standby): only the POWER LED stays lit,
#   STATUS off and green HDD LEDs off (Synology: HIBER_LED_POWER_ONLY).
# The green HDD LEDs are driven by the SATA controller itself (on = present,
# blink = activity). Bay 1 = SATA port ata1, bay 2 = ata2.
# Run by mdadm --monitor (PROGRAM, on every RAID event), a timer and at boot.
set -u
STATE=/run/ds212j-status-led

led_set() {
	f=/sys/class/leds/synology:amber:hdd$1/brightness
	[ -w "$f" ] && echo "$2" > "$f"
}

# all internal disks in standby? (hdparm -C does not wake them up)
asleep=1; disks=0
for b in /sys/block/sd*; do
	[ -e "$b" ] || continue
	case "$(readlink -f "$b")" in */ata[12]/*) ;; *) continue ;; esac
	disks=$((disks + 1))
	/usr/sbin/hdparm -C "/dev/${b##*/}" 2>/dev/null | grep -q standby || asleep=0
done
[ "$disks" = 0 ] && asleep=0

# --- amber HDD LEDs ---
for bay in 1 2; do
	dev=
	for b in /sys/block/sd*; do
		[ -e "$b" ] || continue
		case "$(readlink -f "$b")" in
			*/ata$bay/*) dev=${b##*/} ;;
		esac
	done

	fault=0
	if [ -n "$dev" ]; then
		for st in /sys/block/md*/md/dev-"$dev"*/state; do
			[ -e "$st" ] || continue
			grep -q faulty "$st" && fault=1
		done
		# SMART overall health (don't spin up a sleeping disk); exit status bit 3 = failing
		if [ "$fault" = 0 ] && command -v smartctl >/dev/null; then
			smartctl -H -n standby "/dev/$dev" >/dev/null 2>&1
			[ $(( $? & 8 )) -ne 0 ] && fault=1
		fi
	fi

	led_set "$bay" "$fault"
	[ "$fault" = 1 ] && logger -t ds212j-leds "bay $bay (${dev:-empty}): FAULT, amber LED on"
done

# --- green HDD LEDs: presence mode, off while hibernating ---
if [ "$asleep" = 1 ]; then
	/usr/sbin/ds212j-sata-leds presence off
else
	/usr/sbin/ds212j-sata-leds presence on
fi

# --- STATUS LED ---
status=green
found=0
for md in /sys/block/md*/md; do
	[ -e "$md/array_state" ] || continue
	found=1
	state=$(cat "$md/array_state")
	degraded=$(cat "$md/degraded" 2>/dev/null || echo 0)
	case "$state" in
		clear|inactive|suspended) status=orange-blink ;;
	esac
	[ "$degraded" -gt 0 ] && status=orange-blink
done
[ "$found" = 0 ] && status=orange-blink
[ "$asleep" = 1 ] && status=off

if [ "$(cat "$STATE" 2>/dev/null)" != "$status" ]; then
	/usr/sbin/ds212j-microp status-led "$status" && echo "$status" > "$STATE"
	case "$status" in
		orange-blink) logger -t ds212j-leds "volume degraded or missing: STATUS LED $status" ;;
		off)          logger -t ds212j-leds "disks hibernating: only the power LED stays on" ;;
	esac
fi
exit 0
