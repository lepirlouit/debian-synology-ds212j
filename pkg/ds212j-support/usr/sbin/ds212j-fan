#!/bin/sh
# Synology DS-212j fan control, reproducing DSM's scemd (DSM 6.2.4,
# /usr/syno/etc.defaults/scemd.xml). The DS-212j has no board or CPU
# temperature sensor: DSM drives the fan from the hottest disk.
#
# DSM tables (lower bound in degrees C -> speed level; >= 61 C: shutdown):
#   cool  (DUAL_MODE_HIGH):     0 ULTRA_LOW, 33 VERY_LOW, 41 LOW, 47 VERY_HIGH, 53 ULTRA_HIGH
#   quiet (DUAL_MODE_LOW):      0 ULTRA_LOW, 38 VERY_LOW, 46 LOW, 52 VERY_HIGH, 58 ULTRA_HIGH
#   low-power (..._LOW_STOP):   0 STOP, 33 ULTRA_LOW, 38 VERY_LOW, 46 LOW, 52 VERY_HIGH, 58 ULTRA_HIGH
#   full: always full speed.   Poll every 20 s; fan stopped while all disks sleep.
#
# DSM speed levels are the 3-bit value on GPIO 32-34 (Synology
# FanStatusMappingType1): STOP 0, ULTRA_LOW 1, VERY_LOW 2, LOW 4, VERY_HIGH 6,
# ULTRA_HIGH/FULL 7. They are reproduced exactly; the DS-212j DT lists all 8
# values in that order, so a level is selected by index through pwm1.
# (Measured on one DS-212j: 1 ~925 rpm, 2 stops the fan, 4-7 ~1620-1700 rpm.)
set -u

MODE=low-power
[ -r /etc/default/ds212j-fan ] && . /etc/default/ds212j-fan
PERIOD=20         # seconds, as scemd's period="20"
SLOWDOWN_POLLS=6  # scemd's threshold="6": slow down only after 6 polls in a row
SHUTDOWN_TEMP=61

log() { logger -t ds212j-fan "$*"; }

hwmon=
for n in /sys/class/hwmon/hwmon*/name; do
	[ "$(cat "$n" 2>/dev/null)" = gpio_fan ] && hwmon=${n%/name}
done
[ -n "$hwmon" ] || { log "gpio-fan hwmon device not found"; exit 1; }

# GPIO value (= speed-map index) of each DSM speed level
value_of() {
	case "$1" in
		STOP)            echo 0 ;;
		ULTRA_LOW)       echo 1 ;;
		VERY_LOW)        echo 2 ;;
		MIDDLE)          echo 3 ;;
		LOW)             echo 4 ;;
		HIGH)            echo 5 ;;
		VERY_HIGH)       echo 6 ;;
		ULTRA_HIGH|FULL) echo 7 ;;
	esac
}

level_for() { # $1 = hottest disk temperature
	t=$1
	case "$MODE" in
		full) echo FULL ;;
		cool)
			if   [ "$t" -ge 53 ]; then echo ULTRA_HIGH
			elif [ "$t" -ge 47 ]; then echo VERY_HIGH
			elif [ "$t" -ge 41 ]; then echo LOW
			elif [ "$t" -ge 33 ]; then echo VERY_LOW
			else echo ULTRA_LOW; fi ;;
		quiet)
			if   [ "$t" -ge 58 ]; then echo ULTRA_HIGH
			elif [ "$t" -ge 52 ]; then echo VERY_HIGH
			elif [ "$t" -ge 46 ]; then echo LOW
			elif [ "$t" -ge 38 ]; then echo VERY_LOW
			else echo ULTRA_LOW; fi ;;
		*) # low-power
			if   [ "$t" -ge 58 ]; then echo ULTRA_HIGH
			elif [ "$t" -ge 52 ]; then echo VERY_HIGH
			elif [ "$t" -ge 46 ]; then echo LOW
			elif [ "$t" -ge 38 ]; then echo VERY_LOW
			elif [ "$t" -ge 33 ]; then echo ULTRA_LOW
			else echo STOP; fi ;;
	esac
}

# Hottest internal disk; "sleep" if every disk is in standby, "unknown" if no reading.
disk_temp() {
	max=; awake=0; seen=0
	for b in /sys/block/sd*; do
		[ -e "$b" ] || continue
		case "$(readlink -f "$b")" in */ata[12]/*) ;; *) continue ;; esac
		seen=1
		out=$(smartctl -n standby -A "/dev/${b##*/}" 2>/dev/null)
		[ $? -eq 2 ] && continue   # in standby: not woken up
		awake=1
		t=$(echo "$out" | awk '$1==194 || $1==190 {print $10+0; exit}')
		[ -n "$t" ] && { [ -z "$max" ] || [ "$t" -gt "$max" ]; } && max=$t
	done
	if [ -n "$max" ]; then echo "$max"
	elif [ "$seen" = 1 ] && [ "$awake" = 0 ]; then echo sleep
	else echo unknown; fi
}

# gpio-fan: speed index = DIV_ROUND_UP(pwm * 7, 255), so pwm = index * 255 / 7
set_value() { echo $(( $1 * 255 / 7 )) > "$hwmon/pwm1"; }

echo 1 > "$hwmon/pwm1_enable" 2>/dev/null
cur=; lower_count=0
log "starting, mode $MODE"
while :; do
	t=$(disk_temp)
	# hibernation entered/left: let ds212j-leds switch the front panel (DSM: power LED only)
	if [ "$t" = sleep ] && [ "${was:-}" != sleep ]; then
		log "disks hibernating"; systemctl --no-block start ds212j-leds.service
	elif [ "$t" != sleep ] && [ "${was:-}" = sleep ]; then
		log "disks awake"; systemctl --no-block start ds212j-leds.service
	fi
	was=$t
	case "$t" in
		sleep)   if [ "$MODE" = full ]; then want=7; else want=0; fi ;;  # hibernation_speed="STOP"
		unknown) want=7 ;;                                              # no reading: be safe
		*)
			if [ "$t" -ge "$SHUTDOWN_TEMP" ]; then
				log "disk temperature ${t}C >= ${SHUTDOWN_TEMP}C: shutting down (as DSM does)"
				set_value 7
				/usr/sbin/ds212j-microp beep 2>/dev/null
				systemctl poweroff
				exit 0
			fi
			want=$(value_of "$(level_for "$t")") ;;
	esac

	# the levels used by DSM (0,1,2,4,6,7) are ordered like their values
	if [ -z "$cur" ] || [ "$want" -gt "$cur" ]; then
		# speed up (or first run) immediately
		[ "$want" != "$cur" ] && log "disk ${t}C: fan level -> $want"
		set_value "$want"; cur=$want; lower_count=0
	elif [ "$want" -lt "$cur" ]; then
		lower_count=$((lower_count + 1))
		if [ "$lower_count" -ge "$SLOWDOWN_POLLS" ]; then
			log "disk ${t}C: fan level -> $want"
			set_value "$want"; cur=$want; lower_count=0
		fi
	else
		lower_count=0
	fi
	sleep "$PERIOD"
done
