#!/bin/sh
set -e
if [ "$1" = configure ]; then
	conf=/etc/mdadm/mdadm.conf
	if [ -f "$conf" ]; then
		# upgrade from 1.0/1.1: the script was renamed
		sed -i 's|^PROGRAM /usr/sbin/ds212j-hdd-leds$|PROGRAM /usr/sbin/ds212j-leds|' "$conf"
		grep -q '^PROGRAM' "$conf" || echo 'PROGRAM /usr/sbin/ds212j-leds' >> "$conf"
	fi
	rm -f /etc/systemd/system/timers.target.wants/ds212j-hdd-leds.timer
	systemctl daemon-reload >/dev/null 2>&1 || true
	# journal in RAM (journald.conf.d/ds212j.conf), saved by ds212j-logsave
	systemctl restart systemd-journald.service >/dev/null 2>&1 || true
	systemctl enable --now ds212j-logsave.timer ds212j-logsave-shutdown.service >/dev/null 2>&1 || true
	# disk hibernation delay
	udevadm control --reload >/dev/null 2>&1 || true
	udevadm trigger -c change -s block >/dev/null 2>&1 || true
	# software spin-down of the internal disks only: Debian's hd-idle.service would
	# spin down every disk (USB too) with its defaults, so it is disabled
	systemctl disable --now hd-idle.service >/dev/null 2>&1 || true
	systemctl enable var-lib-systemd-timesync.mount ds212j-hd-idle.service >/dev/null 2>&1 || true
	systemctl start var-lib-systemd-timesync.mount >/dev/null 2>&1 || true
	systemctl try-restart systemd-timesyncd.service >/dev/null 2>&1 || true
	systemctl enable var-lib-smartmontools.mount >/dev/null 2>&1 || true
	systemctl start var-lib-smartmontools.mount >/dev/null 2>&1 || true
	systemctl try-restart smartmontools.service >/dev/null 2>&1 || true
	systemctl restart ds212j-hd-idle.service >/dev/null 2>&1 || true
	# network under memory pressure (udev rule applies it at every boot)
	/usr/sbin/ethtool -K eth0 sg off tso off >/dev/null 2>&1 || true
	sysctl -q -p /usr/lib/sysctl.d/60-ds212j-mem.conf >/dev/null 2>&1 || true
	systemctl try-restart mdmonitor.service >/dev/null 2>&1 || true
	# 1.11: ds212j-fan + ds212j-leds.timer replaced by the resident ds212j-boardd
	systemctl stop ds212j-fan.service ds212j-leds.timer ds212j-leds.service >/dev/null 2>&1 || true
	rm -f /etc/systemd/system/multi-user.target.wants/ds212j-fan.service \
	      /etc/systemd/system/timers.target.wants/ds212j-leds.timer
	systemctl daemon-reload >/dev/null 2>&1 || true
	systemctl reset-failed ds212j-fan.service ds212j-leds.timer ds212j-leds.service >/dev/null 2>&1 || true
	systemctl enable ds212j-power-led.service ds212j-boardd.service >/dev/null 2>&1 || true
	rm -f /run/ds212j-status-led
	systemctl restart ds212j-boardd.service >/dev/null 2>&1 || true
fi
