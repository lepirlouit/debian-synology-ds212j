# Config fragment for the Synology DS-212j, applied on top of mvebu_v5_defconfig:
#   make ARCH=arm mvebu_v5_defconfig
#   scripts/kconfig/merge_config.sh -m .config <this file> && make ARCH=arm olddefconfig

CONFIG_LOCALVERSION="-ds212j"

# --- Boot with the stock Synology U-Boot 1.1.4 (ATAGs only, no DT) ---
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=y
CONFIG_ARM_ATAG_DTB_COMPAT_CMDLINE_FROM_BOOTLOADER=y

# --- What Debian / systemd needs ---
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_SECCOMP=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_UNIX=y
CONFIG_IPV6=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# per-process I/O accounting (/proc/<pid>/io, iotop): needed to find what wakes the disks
CONFIG_TASKSTATS=y
CONFIG_TASK_DELAY_ACCT=y
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y

# --- Storage ---
CONFIG_ATA=y
CONFIG_SATA_MV=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=m
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_MD=y
CONFIG_BLK_DEV_MD=y
CONFIG_MD_RAID1=y
CONFIG_BLK_DEV_DM=m
CONFIG_DM_CRYPT=m
CONFIG_BTRFS_FS=m
CONFIG_XFS_FS=m
CONFIG_FUSE_FS=m
CONFIG_SWAP=y
CONFIG_ZRAM=m
CONFIG_ZSWAP=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y

# --- Board hardware ---
CONFIG_MV643XX_ETH=y
CONFIG_MARVELL_PHY=y
CONFIG_SENSORS_GPIO_FAN=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_DISK=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_RTC_DRV_S35390A=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_QNAP=y
CONFIG_ORION_WATCHDOG=y
CONFIG_CRYPTO_DEV_MARVELL_CESA=m
CONFIG_HW_RANDOM=y
CONFIG_MTD=y
CONFIG_MTD_SPI_NOR=y
CONFIG_MTD_BLOCK=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m

# --- Networking extras (firewall, VPN) as modules ---
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=m
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NF_TABLES_INET=y
CONFIG_WIREGUARD=m
CONFIG_BRIDGE=m
CONFIG_VLAN_8021Q=m
CONFIG_NFS_FS=m
CONFIG_NFSD=m
CONFIG_CIFS=m
