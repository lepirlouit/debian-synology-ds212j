+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Synology DS-212j (Marvell 88F6281 A1, 256 MB DDR2, 4 MB SPI NOR)
+ *
+ * Based on board/Synology/ds109/ds109.c
+ */
+
+#include <config.h>
+#include <init.h>
+#include <asm/global_data.h>
+#include <asm/io.h>
+#include <asm/arch/cpu.h>
+#include <asm/arch/soc.h>
+#include <asm/arch/mpp.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+/* GPIO 20..23: HDD LEDs (active low) -> outputs, high = off */
+#define DS212J_HDD_LEDS		(0xf << 20)
+/* GPIO 32..34: fan speed select (bits 0..2 of the high bank), 35: fan alarm */
+#define DS212J_FAN_MASK		0x7
+#define DS212J_FAN_DEFAULT	0x3	/* ~3800 rpm until Linux takes over */
+
+int board_early_init_f(void)
+{
+	mvebu_config_gpio(DS212J_HDD_LEDS, DS212J_FAN_DEFAULT,
+			  ~DS212J_HDD_LEDS, ~DS212J_FAN_MASK);
+
+	static const u32 kwmpp_config[] = {
+		MPP0_SPI_SCn,		/* SPI flash */
+		MPP1_SPI_MOSI,
+		MPP2_SPI_SCK,
+		MPP3_SPI_MISO,
+		MPP4_GPIO,
+		MPP5_GPO,
+		MPP6_SYSRST_OUTn,
+		MPP7_GPO,
+		MPP8_TW_SDA,		/* I2C: RTC (s35390a) */
+		MPP9_TW_SCK,
+		MPP10_UART0_TXD,	/* console */
+		MPP11_UART0_RXD,
+		MPP12_GPO,		/* alarm LED */
+		MPP13_UART1_TXD,	/* power/LED microcontroller */
+		MPP14_UART1_RXD,
+		MPP15_GPIO,
+		MPP16_GPIO,
+		MPP17_GPIO,
+		MPP18_GPO,
+		MPP19_GPO,
+		MPP20_GPIO,		/* HDD2 green LED */
+		MPP21_GPIO,		/* HDD1 green LED */
+		MPP22_GPIO,		/* HDD2 amber LED */
+		MPP23_GPIO,		/* HDD1 amber LED */
+		MPP24_GPIO,
+		MPP25_GPIO,
+		MPP26_GPIO,
+		MPP27_GPIO,
+		MPP28_GPIO,
+		MPP29_GPIO,
+		MPP30_GPIO,
+		MPP31_GPIO,
+		MPP32_GPIO,		/* fan speed A */
+		MPP33_GPIO,		/* fan speed B */
+		MPP34_GPIO,		/* fan speed C */
+		MPP35_GPIO,		/* fan alarm */
+		MPP36_GPIO,
+		MPP37_GPIO,
+		MPP38_GPIO,
+		MPP39_GPIO,
+		MPP40_GPIO,
+		MPP41_GPIO,
+		MPP42_GPIO,
+		MPP43_GPIO,
+		MPP44_GPIO,
+		MPP45_GPIO,
+		MPP46_GPIO,
+		MPP47_GPIO,
+		MPP48_GPIO,
+		MPP49_GPIO,
+		0
+	};
+	kirkwood_mpp_conf(kwmpp_config, NULL);
+	return 0;
+}
+
+int board_init(void)
+{
+	/* address of boot parameters */
+	gd->bd->bi_boot_params = mvebu_sdram_bar(0) + 0x100;
+
+	return 0;
+}
diff --git a/board/Synology/ds212j/kwbimage.cfg b/board/Synology/ds212j/kwbimage.cfg
new file mode 100644
index 00000000..5fc3c812
--- /dev/null
+++ b/board/Synology/ds212j/kwbimage.cfg
@@ -0,0 +1,36 @@
+# SPDX-License-Identifier: GPL-2.0+
+#
+# Synology DS-212j: Marvell 88F6281 A1, 2 x 128 MB DDR2 (CS0 + CS1), 16-bit bus.
+# The DATA lines below are copied verbatim from the extension header of the
+# stock Synology U-Boot 1.1.4 (Marvell 3.4.4) found at offset 0 of the SPI flash.
+
+BOOT_FROM	spi
+
+DATA 0xFFD100E0 0x1B1B1B9B	# SoC: L2 / SRAM timing
+DATA 0xFFD20134 0xBBBBBBBB	# L2 RAM timing 0
+DATA 0xFFD20138 0x00BBBBBB	# L2 RAM timing 1
+DATA 0xFFD01400 0x43000C30	# DDR Configuration
+DATA 0xFFD01404 0x39743000	# DDR Controller Control Low
+DATA 0xFFD01408 0x23125551	# DDR Timing Low
+DATA 0xFFD0140C 0x00000833	# DDR Timing High
+DATA 0xFFD01410 0x000000DD	# DDR Address Control (2 CS)
+DATA 0xFFD01414 0x00000000	# DDR Open Pages Control
+DATA 0xFFD01418 0x00000000	# DDR Operation
+DATA 0xFFD0141C 0x00000C62	# DDR Mode (CL6)
+DATA 0xFFD01420 0x00000042	# DDR Extended Mode
+DATA 0xFFD01424 0x0000F1FF	# DDR Controller Control High
+DATA 0xFFD01428 0x00085520	# DDR2 ODT Read Timing
+DATA 0xFFD0147C 0x00008552	# DDR2 ODT Write Timing
+DATA 0xFFD01500 0x00000000	# CS0 base 0x00000000
+DATA 0xFFD01504 0x07FFFFF1	# CS0 size 128 MB, enabled
+DATA 0xFFD01508 0x08000000	# CS1 base 0x08000000
+DATA 0xFFD0150C 0x07FFFFF5	# CS1 size 128 MB, enabled
+DATA 0xFFD01510 0x20000000	# CS2 base
+DATA 0xFFD01514 0x00000000	# CS2 disabled
+DATA 0xFFD01518 0x30000000	# CS3 base
+DATA 0xFFD0151C 0x00000000	# CS3 disabled
+DATA 0xFFD01494 0x00330033	# DDR ODT Control Low
+DATA 0xFFD01498 0x00000000	# DDR ODT Control High
+DATA 0xFFD0149C 0x0000F40F	# CPU ODT Control
+DATA 0xFFD01480 0x00000001	# DDR Initialization Control: start
+DATA 0x0 0x0
