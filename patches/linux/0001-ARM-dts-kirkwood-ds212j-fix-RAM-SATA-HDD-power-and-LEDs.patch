ARM: dts: kirkwood-ds212j: fix RAM size, SATA, HDD power, LEDs and fan

- 256 MB of RAM (2 x 128 MB chip selects), not 128 MB
- power the drives: enable the HDD1/HDD2 power regulators (GPIO 29/31)
- SATA pinctrl: only route MPP20/21 (activity LEDs), MPP22/23 are GPIO
  amber LEDs; the generic Synology pinctrl conflicted with the HDD LED
  node and sata_mv failed to probe
- green HDD LEDs driven by the SATA controller in presence mode, amber
  fault LEDs as gpio-leds (same behaviour as DSM)
- GPIO 35 is the fan tachometer, not an alarm: drop alarm-gpios, which
  caused an interrupt + uevent storm (systemd-udevd at ~25% CPU)
- fan speed map: all 8 values in DSM order, with the rpm measured on the
  hardware (value 2 stops this fan)
--- a/arch/arm/boot/dts/marvell/kirkwood-ds212j.dts
+++ b/arch/arm/boot/dts/marvell/kirkwood-ds212j.dts
@@ -18,7 +18,7 @@
 
 	memory {
 		device_type = "memory";
-		reg = <0x00000000 0x8000000>;
+		reg = <0x00000000 0x10000000>;	/* 256 MB: 2 x 128 MB chip selects */
 	};
 
 	chosen {
@@ -28,9 +28,57 @@
 
 	gpio-fan-100-32-35 {
 		status = "okay";
+		/*
+		 * GPIO 35 is the fan tachometer (it toggles while the fan spins,
+		 * Synology's GetFanStatus() samples it for both levels), not an
+		 * alarm line. As alarm-gpios every tach edge raised an interrupt
+		 * and a uevent, keeping systemd-udevd busy (~50 events/s).
+		 */
+		/delete-property/ alarm-gpios;
+		/*
+		 * All 8 values of GPIO 32-34, in order, so that DSM's speed levels
+		 * can be reproduced exactly (Synology FanStatusMappingType1: STOP 0,
+		 * ULTRA_LOW 1, VERY_LOW 2, MIDDLE 3, LOW 4, HIGH 5, VERY_HIGH 6,
+		 * ULTRA_HIGH/FULL 7). The rpm figures are measured on a DS-212j by
+		 * counting GPIO 35 tach pulses (2 per revolution): with this fan,
+		 * value 2 stops it, 1/3 and 4-7 give two distinct speeds. Select a
+		 * level by index through pwm1 (index * 255 / 7).
+		 */
+		gpio-fan,speed-map = <   0 0>,
+				     < 925 1>,
+				     <   0 2>,
+				     < 920 3>,
+				     <1620 4>,
+				     <1690 5>,
+				     <1640 6>,
+				     <1700 7>;
 	};
 
-	gpio-leds-hdd-21-2 {
+	/*
+	 * Like DSM: the green HDD LEDs are driven by the SATA controller
+	 * (MPP20/21 in their "act" function, see &sata below), the amber
+	 * fault LEDs are plain GPIOs (active low).
+	 */
+	gpio-leds-hdd-fault {
+		compatible = "gpio-leds";
+		pinctrl-0 = <&pmx_hddled_23 &pmx_hddled_22>;
+		pinctrl-names = "default";
+
+		led-hdd1-amber {
+			label = "synology:amber:hdd1";
+			gpios = <&gpio0 23 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+
+		led-hdd2-amber {
+			label = "synology:amber:hdd2";
+			gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
+			default-state = "off";
+		};
+	};
+
+	/* HDD1/HDD2 power switches: GPIO 29 and 31, both off at reset */
+	regulators-hdd-29 {
 		status = "okay";
 	};
 };
@@ -38,3 +86,27 @@
 &s35390a {
 	status = "okay";
 };
+
+&pinctrl {
+	pmx_sata0_act_21: pmx-sata0-act-21 {
+		marvell,pins = "mpp21";
+		marvell,function = "sata0";
+	};
+
+	pmx_sata1_act_20: pmx-sata1-act-20 {
+		marvell,pins = "mpp20";
+		marvell,function = "sata1";
+	};
+};
+
+/*
+ * The generic Synology SATA pinctrl also claims MPP4/5/22/23, which are
+ * GPIOs here (MPP22/23: amber LEDs). Only route the two activity LEDs:
+ * MPP21 = HDD1 green, MPP20 = HDD2 green. In presence mode they stay lit
+ * while a drive is attached and blink on activity, as under DSM.
+ */
+&sata {
+	pinctrl-0 = <&pmx_sata0_act_21 &pmx_sata1_act_20>;
+	pinctrl-names = "default";
+	marvell,led-act-presence;
+};
